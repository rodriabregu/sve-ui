{
	"name": "docs",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm gen:props && vite build",
		"preview": "vite preview",
		"check": "pnpm gen:props && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"gen:props": "node scripts/gen-props.mjs",
		"gen:props:check": "node scripts/gen-props.mjs && git diff --exit-code -- src/lib/docs/generated/props.json",
		"check:render": "node scripts/check-render.mjs",
		"check:render:update": "node scripts/check-render.mjs --update",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots"
	},
	"devDependencies": {
		"@internationalized/date": "catalog:",
		"@playwright/test": "^1.62.1",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^26.4.0",
		"eslint": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "^4.0.0",
		"tailwindcss": "catalog:",
		"tslib": "^2.6.2",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"sve-ui": "workspace:*"
	}
}
